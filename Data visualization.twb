      <aliases enabled='yes' />
      <column caption='Delayed flag' datatype='integer' name='[Calculation_1281274100123541504]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [eta_variation_minutes] &gt; 5 THEN 1 ELSE 0 END' />
      </column>
      <column caption='Severe weather label' datatype='string' name='[Calculation_1281274100123680769]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [severe_weather_flag] = 1 THEN &quot;Severe&quot; ELSE &quot;Normal&quot; END' />
      </column>
      <column caption='ETA deviation absolute' datatype='real' name='[Calculation_1281274100123807746]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS([eta_variation_minutes])' />
      </column>
      <column caption='Delivery time bucket' datatype='string' name='[Calculation_1281274100123955203]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [eta_variation_minutes] &lt;= 0 THEN &quot;Early/On Time&quot;&#13;&#10;ELSEIF [eta_variation_minutes] &lt;= 15 THEN &quot;0-15 min late&quot;&#13;&#10;ELSEIF [eta_variation_minutes] &lt;= 30 THEN &quot;15-30 min late&quot;&#13;&#10;ELSE &quot;30+ min late&quot;&#13;&#10;END' />
      </column>
      <column caption='SevereWeatherPercent' datatype='real' name='[Calculation_1281274100139065349]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([severe_weather_flag]) / COUNT([row_id])' />
      </column>
      <column caption='ActiveDelayPercent' datatype='real' name='[Calculation_1281274100139266054]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [eta_variation_minutes] &gt; 5 THEN 1 ELSE 0 END) / COUNT([row_id])' />
      </column>
      <column caption='AvgETADeviationHours' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1281274100139446279]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([eta_variation_minutes]) / 60' />
      </column>
      <column caption='on_time_flag' datatype='integer' name='[Calculation_184084639490187264]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [delivery_time_deviation] &lt;= 0 THEN 1 ELSE 0 END' />
      </column>
      <column caption='OnTimePercent' datatype='real' name='[Calculation_184084639490359297]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_184084639490187264]) / COUNT([row_id])' />
      </column>
      <column caption='delay_hours_abs' datatype='real' name='[Calculation_184084639490670594]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS([delivery_time_deviation])' />
      </column>
      <column caption='cost_eff_ratio' datatype='real' name='[Calculation_184084639490822147]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[shipping_costs] / ([delivery_time_deviation] + 1)' />
      </column>
      <column caption='delay_severity' datatype='string' name='[Calculation_184084639490924548]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [delay_probability] &gt;= 0.8 THEN &quot;Very High&quot;&#13;&#10;ELSEIF [delay_probability] &gt;= 0.5 THEN &quot;High&quot;&#13;&#10;ELSEIF [delay_probability] &gt;= 0.2 THEN &quot;Medium&quot;&#13;&#10;ELSE &quot;Low&quot; END' />
      </column>
      <column caption='Top N Filter' datatype='boolean' name='[Calculation_325666553320226816]' role='measure' type='nominal'>
        <calculation class='tableau' formula='RANK_UNIQUE(AVG([shipping_costs])) &lt;= [Parameters].[Parameter 1]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
