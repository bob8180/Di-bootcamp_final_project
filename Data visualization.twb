      <aliases enabled='yes' />
      <column caption='Profit Ratio pp Neg' datatype='string' name='[Avg Time On Site min % Neg (copy)_6606851055455625236]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IIF([Avg Time On Site min % PoP (copy)_6606851055455625237] &lt; 0,&#10;&apos;↓&apos; + STR(ROUND([Avg Time On Site min % PoP (copy)_6606851055455625237]*100,1)) + &apos;pp&apos;,&apos;&apos;&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Profit Ratio pp PoP' datatype='real' name='[Avg Time On Site min % PoP (copy)_6606851055455625237]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(([Calculation_1368249927221915648])) - LOOKUP(ZN(([Calculation_1368249927221915648])), -[PoP Label (copy)_6606851055452626956]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Profit Ratio pp Pos' datatype='string' name='[Avg Time On Site min % Pos (copy)_6606851055455625238]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IIF([Avg Time On Site min % PoP (copy)_6606851055455625237] &gt; 0,&#10;&apos;↑+&apos; + STR(ROUND([Avg Time On Site min % PoP (copy)_6606851055455625237]*100,1)) + &apos;pp&apos;,&apos;&apos;&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Profit Ratio' datatype='real' default-format='p0.0%' name='[Calculation_1368249927221915648]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit])/SUM([Sales])' />
      </column>
      <column caption='TRUE' datatype='boolean' name='[Calculation_1591037350522720266]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='TRUE&#10;//tech field for info tooltip unhighlight' />
      </column>
      <column caption='Sales per Customer' datatype='real' default-format='c&quot;$&quot;#,##0.0;-&quot;$&quot;#,##0.0' name='[Calculation_4528862052503920642]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales]) / COUNTD([Customer Name])' />
      </column>
      <column caption='Metric calc w param' datatype='real' name='[Calculation_4528862052510269445]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 1]&#10;WHEN &apos;Sales&apos; THEN SUM([Sales])&#10;WHEN &apos;Profit Ratio&apos; THEN [Calculation_1368249927221915648]&#10;WHEN &apos;Sales per Customer&apos; THEN [Calculation_4528862052503920642]&#10;END' />
      </column>
      <column caption='Rank Sales' datatype='integer' name='[Calculation_4528862052512821256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RANK(SUM([Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Date changed' datatype='datetime' default-format='*dd mmm&apos;yy' name='[Calculation_6606851055446556673]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC([Parameters].[Parameter 3], [Order Date])' />
      </column>
      <column caption='LAST' datatype='boolean' name='[Calculation_6606851055446642690]' role='measure' type='nominal'>
        <calculation class='tableau' formula='LAST()=0'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='PoP Label' datatype='string' name='[Calculation_6606851055447478278]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 3] = &apos;month&apos;, &apos;MoM&apos;, &apos;WoW&apos;)' />
      </column>
      <column caption='Bar size' datatype='integer' name='[Calculation_6606851055463948313]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Calculation_6606851055446556673],DATEADD([Parameters].[Parameter 3],1,[Calculation_6606851055446556673]))' />
      </column>
      <column caption='Last Sales % PoP' datatype='real' name='[Calculation_6653857380341260306]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='IIF([Calculation_6606851055446642690],[Nb Uniq Visitors (copy) (copy)_6606851055447162884], NULL)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='string' name='[Category]' role='dimension' type='nominal' />
      <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='string' name='[Country/Region]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column datatype='string' hidden='true' name='[Customer ID]' role='dimension' type='nominal' />
      <column datatype='string' name='[Customer Name]' role='dimension' type='nominal' />
      <column caption='Metric calc w param Color' datatype='real' name='[Metric calc w param (copy)_4528862052511305734]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 1 1] = &apos;Profit Ratio&apos;, [Calculation_4528862052510269445], RANK_PERCENTILE([Calculation_4528862052510269445]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Metric calc w param Label' datatype='string' name='[Metric calc w param color (copy)_4528862052511653895]' role='measure' type='nominal'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1 1] &#10;WHEN &apos;Sales&apos; THEN &apos;$&apos;+STR(SUM([Sales])) &#10;WHEN &apos;Profit Ratio&apos; THEN STR(ROUND([Calculation_1368249927221915648] * 100, 1)) + &apos;%&apos;&#10;WHEN &apos;Sales per Customer&apos; THEN &apos;$&apos;+STR(ROUND([Calculation_4528862052503920642],1)) &#10;END' />
      </column>
      <column caption='Sales per Customer % Neg' datatype='string' name='[Nb Uniq Visitors % Neg (copy)_6606851055451500552]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IIF([Nb Uniq Visitors % PoP (copy)_6606851055451500553] &lt; 0,&#10;&apos;↓&apos; + STR(ROUND([Nb Uniq Visitors % PoP (copy)_6606851055451500553]*100,1)) + &apos;%&apos;,&apos;&apos;&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Sales per Customer % PoP' datatype='real' name='[Nb Uniq Visitors % PoP (copy)_6606851055451500553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(([Calculation_4528862052503920642])) - LOOKUP(ZN(([Calculation_4528862052503920642])), -[PoP Label (copy)_6606851055452626956])) / ABS(LOOKUP(ZN(([Calculation_4528862052503920642])), -[PoP Label (copy)_6606851055452626956]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Sales % Neg' datatype='string' name='[Nb Uniq Visitors % Pos (copy)_6606851055447355397]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IIF([Nb Uniq Visitors (copy) (copy)_6606851055447162884] &lt; 0,&#10;&apos;↓&apos; + STR(ROUND([Nb Uniq Visitors (copy) (copy)_6606851055447162884]*100,1)) + &apos;%&apos;,&apos;&apos;&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Sales per Customer % Pos' datatype='string' name='[Nb Uniq Visitors % Pos (copy)_6606851055451500554]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IIF([Nb Uniq Visitors % PoP (copy)_6606851055451500553] &gt; 0,&#10;&apos;↑+&apos; + STR(ROUND([Nb Uniq Visitors % PoP (copy)_6606851055451500553]*100,1)) + &apos;%&apos;,&apos;&apos;&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Sales % PoP' datatype='real' name='[Nb Uniq Visitors (copy) (copy)_6606851055447162884]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(ZN(SUM([Sales])) - LOOKUP(ZN(SUM([Sales])), -[PoP Label (copy)_6606851055452626956])) / ABS(LOOKUP(ZN(SUM([Sales])), -[PoP Label (copy)_6606851055452626956]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Sales % Pos' datatype='string' name='[Nb Uniq Visitors (copy)_6606851055447101443]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IIF([Nb Uniq Visitors (copy) (copy)_6606851055447162884] &gt; 0,&#10;&apos;↑+&apos; + STR(ROUND([Nb Uniq Visitors (copy) (copy)_6606851055447162884]*100,1)) + &apos;%&apos;,&apos;&apos;&#10;)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column datatype='string' hidden='true' name='[Order ID (Returns)]' role='dimension' type='nominal' />
      <column caption='PoP Period Gap' datatype='integer' name='[PoP Label (copy)_6606851055452626956]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IIF([Parameters].[Parameter 3] = &apos;day&apos;, 7, 1)&#10;//1 week or 1 month ago or 7 days ago' />
      </column>
