            <column-instance column='[delay_probability]' derivation='Avg' name='[avg:delay_probability:qk]' pivot='key' type='quantitative' />
            <column datatype='real' default-format='n#,##0.0;-#,##0.0' name='[delay_probability]' role='measure' type='quantitative' />
            <column aggregation='None' caption='driver_behavior_score (bin)' datatype='integer' name='[driver_behavior_score (bin)]' role='dimension' type='ordinal'>
              <calculation class='bin' decimals='-2' formula='[driver_behavior_score]' peg='0' size='0.046' />
            </column>
            <column aggregation='Sum' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[driver_behavior_score]' role='dimension' type='ordinal' />
            <column-instance column='[driver_behavior_score (bin)]' derivation='None' name='[none:driver_behavior_score (bin):ok]' pivot='key' type='ordinal' />
            <column-instance column='[traffic_category]' derivation='None' name='[none:traffic_category:nk]' pivot='key' type='nominal' />
            <column datatype='string' name='[traffic_category]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <slices>
            <column>[federated.17h2cxd0yrom2d1d70ucz066a1mh].[none:traffic_category:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='axis'>
            <format attr='title' class='0' field='[federated.17h2cxd0yrom2d1d70ucz066a1mh].[avg:delay_probability:qk]' scope='rows' value='Average Delay Probability' />
          </style-rule>
          <style-rule element='header'>
            <format attr='height-header' value='18' />
          </style-rule>
          <style-rule element='worksheet'>
            <format attr='display-field-labels' scope='cols' value='false' />
          </style-rule>
        </style>
        <panes>
