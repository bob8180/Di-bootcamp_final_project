    <worksheet name='Delivery Reliability &amp; Risk'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#000000' fontname='Benton Sans Book'>Delivery Reliability &amp; Risk</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='cleaned_logistics_data' name='federated.17h2cxd0yrom2d1d70ucz066a1mh' />
          </datasources>
          <datasource-dependencies datasource='federated.17h2cxd0yrom2d1d70ucz066a1mh'>
            <column caption='SevereWeatherPercent' datatype='real' name='[Calculation_1281274100139065349]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([severe_weather_flag]) / COUNT([row_id])' />
            </column>
            <column caption='ActiveDelayPercent' datatype='real' name='[Calculation_1281274100139266054]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [eta_variation_minutes] &gt; 5 THEN 1 ELSE 0 END) / COUNT([row_id])' />
            </column>
            <column caption='AvgETADeviationHours' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1281274100139446279]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([eta_variation_minutes]) / 60' />
            </column>
            <column caption='on_time_flag' datatype='integer' name='[Calculation_184084639490187264]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [delivery_time_deviation] &lt;= 0 THEN 1 ELSE 0 END' />
            </column>
            <column caption='OnTimePercent' datatype='real' name='[Calculation_184084639490359297]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_184084639490187264]) / COUNT([row_id])' />
            </column>
            <column aggregation='Sum' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[delivery_time_deviation]' role='dimension' type='quantitative' />
            <column datatype='real' default-format='n#,##0;-#,##0' name='[eta_variation_minutes]' role='measure' type='quantitative' />
            <column-instance column='[traffic_category]' derivation='None' name='[none:traffic_category:nk]' pivot='key' type='nominal' />
            <column-instance column='[row_id]' derivation='Count' name='[pcto:cnt:row_id:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Rows' type='PctTotal' />
            </column-instance>
            <column datatype='integer' name='[row_id]' role='measure' type='quantitative' />
            <column datatype='integer' name='[severe_weather_flag]' role='measure' type='quantitative' />
            <column datatype='string' name='[traffic_category]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1281274100139065349]' derivation='User' name='[usr:Calculation_1281274100139065349:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1281274100139266054]' derivation='User' name='[usr:Calculation_1281274100139266054:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1281274100139446279]' derivation='User' name='[usr:Calculation_1281274100139446279:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_184084639490359297]' derivation='User' name='[usr:Calculation_184084639490359297:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
