    <worksheet name='Driver_Delay'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontsize='12'>Driver Behavior vs Delay Probability</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontsize='6'>An indicator of the driver&apos;s behavior based on driving patterns (scale 0-1). Includes speed consistency, harsh events, idle time, speeding vs. limits, smoothness of driving, fatigue indicators, distraction indicators, compliance with driving hours.</run>
            <run>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='cleaned_logistics_data' name='federated.17h2cxd0yrom2d1d70ucz066a1mh' />
          </datasources>
